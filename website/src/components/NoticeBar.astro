---
// Where other sites put a cookie banner: a note that this one has nothing to consent to.
---
<aside class="nb" data-nb aria-label="About this website" hidden>
  <div class="nb-ic" aria-hidden="true">
    <svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="12" /><path d="M7.5 24.5 24.5 7.5" /></svg>
  </div>
  <p><strong>No cookie banner here.</strong> This website has no cookies, no analytics and no trackers. Same as the app.</p>
  <button class="btn btn-glass btn-sm" type="button" data-nb-close>Nice</button>
</aside>

<script>
  const nb = document.querySelector<HTMLElement>('[data-nb]');
  let seen = false;
  try {
    seen = !!localStorage.getItem('swirvo-nb');
  } catch {}
  if (nb && !seen) {
    // Wait until the visitor has settled in: some scrolling, or a while on the page.
    let shown = false;
    const show = () => {
      if (shown) return;
      shown = true;
      nb.hidden = false;
      requestAnimationFrame(() => nb.classList.add('in'));
    };
    const onScroll = () => {
      if (scrollY > innerHeight * 1.2) {
        removeEventListener('scroll', onScroll);
        setTimeout(show, 600);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    setTimeout(show, 12000);
    nb.querySelector('[data-nb-close]')?.addEventListener('click', () => {
      nb.classList.remove('in');
      nb.classList.add('out');
      setTimeout(() => nb.remove(), 500);
      try {
        localStorage.setItem('swirvo-nb', '1');
      } catch {}
    });
  }
</script>

<style>
  .nb {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: var(--z-toast);
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 12px 12px 14px;
    border-radius: var(--r-lg);
    background: var(--glass-strong);
    border: 1px solid var(--line-2);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow: var(--shadow-3);
    font-size: 0.86rem;
    color: var(--text-2);
    transform: translateY(140%) rotate(-3deg);
    opacity: 0;
    transition: transform 800ms var(--spring-bouncy), opacity 300ms;
  }
  .nb.in { transform: none; opacity: 1; }
  .nb.out { transform: translateY(140%) rotate(3deg); opacity: 0; transition: transform 450ms var(--ease-in), opacity 300ms; }
  .nb p { margin: 0; line-height: 1.45; }
  .nb strong { color: var(--text); }
  .nb-ic { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 10px; background: rgba(111, 214, 154, 0.1); }
  .nb-ic svg { width: 22px; height: 22px; fill: none; stroke: var(--mint); stroke-width: 2; stroke-linecap: round; }
  .nb-ic path { stroke-dasharray: 26; stroke-dashoffset: 26; }
  .nb.in .nb-ic path { stroke-dashoffset: 0; transition: stroke-dashoffset 700ms var(--ease-out) 500ms; }
  .nb .btn { flex: none; }
  @media (max-width: 560px) {
    .nb { left: 12px; right: 12px; bottom: 12px; max-width: none; }
  }
</style>
