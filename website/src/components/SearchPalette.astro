---
import Icon from './Icon.astro';
---
<dialog class="pal" data-palette aria-label="Search Swirvo">
  <div class="pal-box">
    <label class="pal-top">
      <Icon name="search" size={20} />
      <input
        type="search"
        placeholder="Search docs, tools, formats… try “heic” or “redact”"
        autocomplete="off"
        spellcheck="false"
        aria-controls="pal-list"
        data-pal-input
      />
      <kbd>Esc</kbd>
    </label>
    <div class="pal-body">
      <ul id="pal-list" class="pal-list" role="listbox" data-pal-list></ul>
      <span class="pal-hl" aria-hidden="true"></span>
      <p class="pal-empty" data-pal-empty hidden>Nothing found. Try a format (<code>pdf</code>), a tool (<code>merge</code>) or a question (<code>uninstall</code>).</p>
    </div>
    <div class="pal-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>Enter</kbd> open</span>
      <span class="pal-count" data-pal-count></span>
    </div>
  </div>
</dialog>

<script>
  import { Spring, onTick, reduced } from '../scripts/motion';

  interface Item {
    t: string; // title
    s?: string; // subtitle
    u: string; // url
    k: string; // kind
    x?: string; // extra searchable text
  }
  const dlg = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-pal-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-pal-list]')!;
  const empty = dlg.querySelector<HTMLElement>('[data-pal-empty]')!;
  const count = dlg.querySelector<HTMLElement>('[data-pal-count]')!;
  const hl = dlg.querySelector<HTMLElement>('.pal-hl')!;
  let data: Item[] | null = null;
  let results: Item[] = [];
  let sel = 0;

  async function load() {
    if (data) return;
    try {
      data = await (await fetch('/search.json')).json();
    } catch {
      data = [];
    }
  }
  const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^\p{L}\p{N}.+#/ -]/gu, ' ');
  function score(it: Item, words: string[]) {
    const title = norm(it.t);
    const hay = norm(`${it.t} ${it.s ?? ''} ${it.x ?? ''} ${it.k}`);
    let sc = 0;
    for (const w of words) {
      if (!hay.includes(w)) return -1;
      if (title === w) sc += 12;
      else if (title.startsWith(w)) sc += 8;
      else if (new RegExp(`\\b${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(title)) sc += 5;
      else if (title.includes(w)) sc += 3;
      else sc += 1;
    }
    return sc + (it.k === 'Page' ? 1.5 : it.k === 'Docs' ? 1 : 0);
  }
  const DEFAULT = ['Getting started', 'Download', 'The wheel', 'Command line', 'AI assistants (MCP)', 'Troubleshooting'];
  function search(q: string) {
    if (!data) return;
    const words = norm(q).split(/\s+/).filter(Boolean);
    if (!words.length) {
      results = DEFAULT.map((t) => data!.find((d) => d.t === t)).filter(Boolean) as Item[];
    } else {
      results = data
        .map((it) => [it, score(it, words)] as const)
        .filter(([, s]) => s >= 0)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 40)
        .map(([it]) => it);
    }
    render();
  }
  function render() {
    list.replaceChildren(
      ...results.map((it, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = `pal-${i}`;
        li.style.setProperty('--i', String(Math.min(i, 12)));
        const a = document.createElement('a');
        a.href = it.u;
        a.innerHTML = `<span class="pk"></span><span class="pt"></span><span class="ps"></span>`;
        (a.children[0] as HTMLElement).textContent = it.k;
        (a.children[1] as HTMLElement).textContent = it.t;
        (a.children[2] as HTMLElement).textContent = it.s ?? '';
        li.append(a);
        li.addEventListener('pointermove', () => select(i));
        return li;
      })
    );
    empty.hidden = results.length > 0;
    count.textContent = results.length ? `${results.length} result${results.length === 1 ? '' : 's'}` : '';
    sel = 0;
    select(0, true);
  }
  const hy = new Spring(0, 420, 32);
  const hh = new Spring(0, 420, 32);
  let stop: (() => void) | null = null;
  function select(i: number, instant = false) {
    if (!results.length) {
      hl.style.opacity = '0';
      return;
    }
    sel = (i + results.length) % results.length;
    const li = list.children[sel] as HTMLElement;
    list.querySelectorAll('[aria-selected]').forEach((n) => n.removeAttribute('aria-selected'));
    li.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', li.id);
    li.scrollIntoView({ block: 'nearest' });
    hy.target = li.offsetTop - list.scrollTop;
    hh.target = li.offsetHeight;
    hl.style.opacity = '1';
    if (instant || reduced) {
      hy.value = hy.target;
      hh.value = hh.target;
      hl.style.transform = `translateY(${hy.value}px)`;
      hl.style.height = `${hh.value}px`;
      return;
    }
    if (stop) return;
    stop = onTick((dt) => {
      hy.step(dt);
      hh.step(dt);
      hl.style.transform = `translateY(${hy.value.toFixed(2)}px)`;
      hl.style.height = `${hh.value.toFixed(2)}px`;
      if (hy.settled && hh.settled) {
        stop = null;
        return false;
      }
    });
  }
  list.addEventListener('scroll', () => select(sel, true));

  async function open() {
    if (dlg.open) return;
    dlg.showModal();
    document.documentElement.classList.add('pal-open');
    input.value = '';
    await load();
    search('');
    input.focus();
  }
  function close() {
    dlg.classList.add('closing');
    setTimeout(() => {
      dlg.classList.remove('closing');
      dlg.close();
      document.documentElement.classList.remove('pal-open');
    }, 180);
  }
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-search-open]')) {
      e.preventDefault();
      open();
    }
  });
  addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      dlg.open ? close() : open();
    }
  });
  input.addEventListener('input', () => search(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      // A search field spends Esc on clearing itself, and the dialog never hears it.
      e.preventDefault();
      close();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      select(sel + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      select(sel - 1);
    } else if (e.key === 'Enter') {
      const a = list.children[sel]?.querySelector('a');
      if (a) {
        e.preventDefault();
        a.click();
      }
    }
  });
  dlg.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) close();
  });
  list.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) close();
  });
</script>

<style>
  .pal {
    width: min(680px, calc(100% - 24px));
    max-height: min(620px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }
  .pal::backdrop {
    background: color-mix(in oklab, var(--bg) 60%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fade 240ms var(--ease-out);
  }
  @keyframes fade { from { opacity: 0; } }
  .pal-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    border-radius: var(--r-xl);
    background: color-mix(in oklab, var(--surface) 97%, transparent);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-3), 0 0 0 1px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    overflow: hidden;
    animation: pop 560ms var(--spring-bouncy) both;
    transform-origin: 50% 0;
  }
  .pal.closing .pal-box { animation: unpop 180ms var(--ease-in) both; }
  @keyframes pop { from { opacity: 0; transform: translateY(-10px) scale(0.94); } }
  @keyframes unpop { to { opacity: 0; transform: translateY(-6px) scale(0.97); } }
  .pal-top { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); color: var(--text-3); }
  .pal-top input { flex: 1; border: 0; outline: 0; background: transparent; font-size: 1.08rem; color: var(--text); min-width: 0; }
  .pal-top input::placeholder { color: var(--text-3); }
  .pal-top input::-webkit-search-cancel-button { display: none; }
  .pal-body { position: relative; overflow: hidden; display: flex; flex-direction: column; min-height: 120px; }
  .pal-list { list-style: none; padding: 8px; margin: 0; overflow-y: auto; position: relative; z-index: 1; overscroll-behavior: contain; }
  /* The results are built by script, so they need :global() to see these styles */
  .pal-list :global(li) { animation: item-in 420ms var(--spring-soft) both; animation-delay: calc(var(--i) * 18ms); }
  @keyframes item-in { from { opacity: 0; transform: translateY(8px); } }
  .pal-list :global(a) {
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text-2);
  }
  .pal-list :global([aria-selected] a) { color: var(--text); }
  .pal-list :global(.pk) { grid-row: 1 / 3; align-self: center; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .pal-list :global(.pt) { min-width: 0; font-weight: 600; color: var(--text); }
  .pal-list :global(.ps) { min-width: 0; font-size: 0.84rem; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pal-list :global(.ps:empty) { display: none; }
  .pal-hl {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 8px;
    border-radius: 12px;
    background: var(--surface-3);
    border: 1px solid var(--line-2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }
  .pal-hl::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 3px; border-radius: 3px; background: var(--ember); }
  .pal-empty { padding: 28px 22px; color: var(--text-3); font-size: 0.92rem; }
  .pal-foot { display: flex; gap: 16px; align-items: center; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 0.78rem; color: var(--text-3); }
  .pal-foot kbd { height: 1.7em; min-width: 1.7em; font-size: 0.7rem; margin-right: 2px; box-shadow: 0 2px 0 var(--line-3); }
  .pal-count { margin-left: auto; }
  @media (pointer: coarse) {
    .pal-box { background: var(--surface); }
  }
  @media (max-width: 560px) {
    .pal { margin-top: 70px; }
    .pal-list :global(a) { grid-template-columns: 52px minmax(0, 1fr); padding: 10px 8px; }
    .pal-top input { font-size: 1rem; }
    .pal-foot span:not(.pal-count) { display: none; }
  }
</style>
