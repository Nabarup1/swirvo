---
import { release } from '../data/github';
import Icon from './Icon.astro';
const r = await release();
---
<div class="announce" data-announce={r.version}>
  <div class="wrap announce-in">
    <span class="pulse" aria-hidden="true"></span>
    <p>
      <strong>Swirvo {r.version}</strong>
      <span class="sep" aria-hidden="true">·</span>
      <span class="hide-sm">Now on the Microsoft Store, plus Linux builds for x64 and ARM64.</span>
      <span class="show-sm">Now on the Microsoft Store.</span>
    </p>
    <a href="/changelog" class="announce-link">What’s new <Icon name="arrowRight" size={14} /></a>
    <button class="announce-x" aria-label="Dismiss this notice" data-announce-close><Icon name="x" size={14} /></button>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-announce]');
  if (bar) {
    const key = 'swirvo-announce-' + bar.dataset.announce;
    try {
      if (localStorage.getItem(key)) bar.remove();
    } catch {}
    bar.querySelector('[data-announce-close]')?.addEventListener('click', () => {
      bar.classList.add('gone');
      bar.addEventListener('transitionend', () => bar.remove(), { once: true });
      try {
        localStorage.setItem(key, '1');
      } catch {}
    });
  }
</script>

<style>
  .announce {
    position: relative;
    z-index: calc(var(--z-header) + 1);
    overflow: hidden;
    color: var(--text-on-ember);
    background: var(--ember-grad-wide);
    background-size: 200% 100%;
    animation: slide-bg 14s linear infinite alternate;
    font-size: 0.88rem;
    max-height: 60px;
    transition: max-height 420ms var(--ease-out), opacity 300ms var(--ease-out);
  }
  .announce.gone { max-height: 0; opacity: 0; }
  @keyframes slide-bg { to { background-position: 100% 0; } }
  .announce-in {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 40px;
    padding-right: 34px;
    position: relative;
  }
  .announce p { margin: 0; line-height: 1.3; }
  .sep { opacity: 0.6; margin-inline: 4px; }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    animation: pulse 2.2s var(--ease-out) infinite;
    flex: none;
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(255, 255, 255, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); } }
  .announce-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 650;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(26, 13, 7, 0.14);
    transition: background 200ms, gap 300ms var(--spring-bouncy);
    white-space: nowrap;
  }
  .announce-link:hover { background: rgba(26, 13, 7, 0.24); gap: 8px; }
  .announce-x {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    color: inherit;
    opacity: 0.75;
    transition: opacity 200ms, background 200ms, rotate 400ms var(--spring-bouncy);
  }
  .announce-x:hover { opacity: 1; background: rgba(26, 13, 7, 0.14); rotate: 90deg; }
  .show-sm { display: none; }
  @media (max-width: 720px) {
    .hide-sm { display: none; }
    .show-sm { display: inline; }
    .announce-in { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .announce { animation: none; } }
</style>
