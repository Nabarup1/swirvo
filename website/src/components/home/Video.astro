---
import Icon from '../Icon.astro';
---
<section class="section vid-sec" aria-labelledby="vid-title">
  <div class="wrap">
    <div class="vid-head sec-head">
      <p class="eyebrow" data-reveal>50 seconds</p>
      <h2 id="vid-title" data-split>See the whole thing <span class="serif ember-text">in motion.</span></h2>
    </div>
    <div class="player" data-player data-reveal="mask">
      <video
        preload="none"
        playsinline
        poster="/media/screen-wheel.png"
        src="/media/swirvo-demo.mp4"
        aria-label="Swirvo demo video with voiceover"
      ></video>
      <button class="play" type="button" data-play aria-label="Play the demo video" data-magnetic="0.35" data-cursor="Play">
        <span class="play-ring"></span>
        <Icon name="play" size={30} />
      </button>
    </div>
  </div>
</section>

<script>
  const p = document.querySelector<HTMLElement>('[data-player]');
  const v = p?.querySelector('video');
  const b = p?.querySelector<HTMLButtonElement>('[data-play]');
  if (p && v && b) {
    b.addEventListener('click', () => {
      p.classList.add('playing');
      v.controls = true;
      v.play().catch(() => {});
    });
    v.addEventListener('ended', () => p.classList.remove('playing'));
  }
</script>

<style>
  .vid-head { text-align: center; margin-bottom: 40px; }
  .vid-head h2 { margin-top: 12px; }
  .player {
    position: relative;
    border-radius: var(--r-2xl);
    overflow: hidden;
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-3), 0 0 120px -40px rgba(238, 106, 52, 0.5);
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .player video { width: 100%; height: 100%; object-fit: cover; }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96px;
    height: 96px;
    margin: -48px 0 0 -48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--text-on-ember);
    background: var(--ember-grad);
    box-shadow: 0 20px 60px -10px rgba(238, 106, 52, 0.8);
    --bx: 0px;
    --by: 0px;
    transform: translate3d(var(--bx), var(--by), 0);
    transition: transform 600ms var(--spring-bouncy), opacity 300ms;
  }
  .play:hover { transform: translate3d(var(--bx), var(--by), 0) scale(1.08); }
  .play :global(svg) { translate: 3px 0; }
  .play-ring { position: absolute; inset: -14px; border-radius: 50%; border: 2px solid rgba(255, 160, 106, 0.5); animation: ring 2.4s var(--ease-out) infinite; }
  @keyframes ring { from { transform: scale(0.8); opacity: 1; } to { transform: scale(1.5); opacity: 0; } }
  .player:global(.playing) .play { opacity: 0; pointer-events: none; }
  @media (max-width: 560px) {
    .player { border-radius: 18px; }
    .play { width: 64px; height: 64px; margin: -32px 0 0 -32px; }
    .play :global(svg) { width: 22px; height: 22px; }
    .play-ring { inset: -8px; }
  }
</style>
