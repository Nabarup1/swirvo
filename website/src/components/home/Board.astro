---
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
const CARDS = [
  { name: 'Quarterly report.docx', type: 'DOCX', size: '46 KB', to: 'PDF', out: '182 KB', pct: '+296%', thumb: 'doc' },
  { name: 'Team handbook.pdf', type: 'PDF', size: '2.4 MB', to: 'DOCX', out: '410 KB', pct: '−83%', thumb: 'pdf' },
  { name: 'Sunset.png', type: 'PNG', size: '158 KB', to: 'JPG', out: '71 KB', pct: '−55%', thumb: 'sunset' },
  { name: 'Holiday.heic', type: 'HEIC', size: '3.1 MB', to: 'JPG', out: '1.4 MB', pct: '−55%', thumb: 'photo' },
  { name: 'Resume.pdf', type: 'PDF', size: '47 KB', to: 'DOCX', out: '99 KB', pct: '+112%', thumb: 'resume' },
  { name: 'Project plan.odt', type: 'ODT', size: '52 KB', to: 'PDF', out: '146 KB', pct: '+182%', thumb: 'doc' },
  { name: 'Meeting notes.md', type: 'MD', size: '1 KB', to: 'HTML', out: '2 KB', pct: '+99%', thumb: 'md' },
  { name: 'Budget.csv', type: 'CSV', size: '84 KB', to: 'XLSX', out: '61 KB', pct: '−27%', thumb: 'csv' },
];
const ROWS = [
  ['DOCX', '1 file', 'PDF'],
  ['PDF', '2 files', 'DOCX'],
  ['PNG', '1 file', 'JPG'],
  ['HEIC', '1 file', 'JPG'],
  ['ODT', '1 file', 'PDF'],
  ['MD', '1 file', 'HTML'],
  ['CSV', '1 file', 'XLSX'],
];
---
<section class="section board-sec" aria-labelledby="board-title">
  <div class="wrap">
    <div class="board-head">
      <div>
        <p class="eyebrow" data-reveal>The Board</p>
        <h2 id="board-title" data-split>Whole folders. <span class="serif ember-text">One press.</span></h2>
      </div>
      <p class="lead" data-reveal style="--delay:120ms">
        Drop in a folder, give every type its own target, and convert them all at once, in parallel across your CPU cores.
        Double-click the tray icon, or tap <kbd>Alt</kbd> mid-drag and pick Board.
      </p>
    </div>

    <div class="board-stage" data-board-stage>
      <div class="board" data-board role="img" aria-label="The Swirvo Board converting eight files in parallel">
        <div class="b-bar">
          <Logo size={20} href={null} wordmark={false} />
          <span class="b-title">Swirvo <span class="faint">Board</span></span>
          <span class="b-btn"><Icon name="arrowDown" size={14} /> Add files</span>
          <span class="b-btn ghost"><Icon name="check" size={14} /> Select all</span>
          <span class="b-btn ghost"><Icon name="wand" size={14} /> Clear done</span>
          <span class="b-ctl" aria-hidden="true"><Icon name="settings" size={15} /><i></i><i></i><i></i></span>
        </div>
        <div class="b-body">
          <aside class="b-side">
            <div class="b-tabs"><span class="on">Convert</span><span>Tools</span></div>
            <div class="b-search"><Icon name="search" size={14} />Search formats and files (Ctrl+F)</div>
            <p class="b-label">Convert to</p>
            <ul class="b-rows" role="list">
              {ROWS.map(([from, n, to]) => (
                <li><span class="b-from">{from}</span><span class="faint">{n}</span><span class="b-to">→ {to}<Icon name="chevronDown" size={12} /></span></li>
              ))}
            </ul>
            <div class="b-q">
              <span class="faint">Quality</span>
              <span class="b-seg"><span>Best</span><span class="on">Balanced</span><span>Small</span></span>
            </div>
            <div class="b-q"><span class="faint">Save to</span><span class="b-sel">Next to originals <Icon name="chevronDown" size={12} /></span></div>
            <p class="b-done" data-b-done><Icon name="check" size={14} /> <span>8 converted · 5.9 MB → 2.4 MB</span></p>
            <button class="b-go" type="button" data-b-go><Icon name="arrowRight" size={16} /> <span>Convert 8 files</span></button>
          </aside>
          <div class="b-grid">
            {CARDS.map((c, i) => (
              <div class="b-card" style={`--i:${i}`} data-b-card>
                <div class={`b-thumb t-${c.thumb}`}>
                  <span class="b-type">{c.type}</span>
                  <svg class="b-ring" viewBox="0 0 36 36"><circle r="15" cx="18" cy="18" pathLength="100" /></svg>
                </div>
                <p class="b-name">{c.name}</p>
                <p class="b-size faint">{c.size}</p>
                <p class="b-status">
                  <span class="s-wait">{c.type} → {c.to}</span>
                  <span class="s-ok"><Icon name="check" size={12} /> {c.to} · {c.out} · {c.pct}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
        <div class="b-foot"><span>8 files · 5.9 MB</span><span class="faint">Built-in engines · OCR ✓</span></div>
      </div>
      <span class="callout c1" data-reveal style="--delay:300ms"><b>Per type</b> PNG → JPG, PDF → Word, each its own</span>
      <span class="callout c2" data-reveal style="--delay:450ms"><b>Parallel</b> one job per core</span>
      <span class="callout c3" data-reveal style="--delay:600ms"><b>Never overwrites</b> new files, originals untouched</span>
    </div>

    <ul class="board-feats" role="list" data-stagger="80">
      <li><Icon name="layers" /><div><h3>A target per type</h3><p class="muted">All PNGs to JPG, all PDFs to Word, all HEICs to JPG: one row each.</p></div></li>
      <li><Icon name="search" /><div><h3>Search everything</h3><p class="muted"><kbd>Ctrl</kbd> <kbd>F</kbd> finds files, formats and tools, even tools for files you haven’t added yet.</p></div></li>
      <li><Icon name="eye" /><div><h3>See it before you save</h3><p class="muted">Watermark, crop, redaction and page numbers show the page as it will be. Drag the watermark where you want it.</p></div></li>
      <li><Icon name="doc" /><div><h3>A page picker for long PDFs</h3><p class="muted">Click pages or type <code>1-3, 7, 10-</code>. Split into your own groups, reorder, rotate, delete.</p></div></li>
    </ul>
  </div>
</section>

<script>
  import { reduced } from '../../scripts/motion';
  const stage = document.querySelector<HTMLElement>('[data-board-stage]');
  const board = document.querySelector<HTMLElement>('[data-board]');
  const go = document.querySelector<HTMLButtonElement>('[data-b-go]');
  if (stage && board && go) {
    // The board tips back and straightens as it scrolls into view.
    if (!reduced) {
      let q = false;
      const tilt = () => {
        q = false;
        const r = stage.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.9)));
        const e = 1 - Math.pow(1 - p, 3);
        board.style.transform = `perspective(1600px) rotateX(${(1 - e) * 24}deg) scale(${0.9 + e * 0.1}) translateY(${(1 - e) * 40}px)`;
      };
      addEventListener('scroll', () => { if (!q) { q = true; requestAnimationFrame(tilt); } }, { passive: true });
      tilt();
    }
    let running = false;
    const run = () => {
      if (running) return;
      running = true;
      board.classList.remove('done');
      board.classList.add('running');
      go.querySelector('span')!.textContent = 'Cancel';
      const cards = [...board.querySelectorAll<HTMLElement>('[data-b-card]')];
      cards.forEach((c) => c.classList.remove('ok'));
      const t = cards.map(() => 500 + Math.random() * 1100);
      cards.forEach((c, i) => {
        c.style.setProperty('--dur', `${t[i]}ms`);
        setTimeout(() => c.classList.add('ok'), reduced ? 0 : t[i] + 120);
      });
      setTimeout(() => {
        board.classList.remove('running');
        board.classList.add('done');
        go.querySelector('span')!.textContent = 'Convert again';
        running = false;
      }, reduced ? 10 : Math.max(...t) + 300);
    };
    go.addEventListener('click', run);
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) {
        setTimeout(run, 700);
        o.disconnect();
      }
    }, { threshold: 0.5 }).observe(board);
  }
</script>

<style>
  .board-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 48px; align-items: end; margin-bottom: 48px; }
  .board-head h2 { margin-top: 12px; }
  .board-stage { position: relative; }
  .board {
    position: relative;
    border-radius: 18px;
    background: linear-gradient(180deg, #221d27, #1a161e);
    border: 1px solid rgba(255, 236, 220, 0.12);
    box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(0, 0, 0, 0.3), 0 0 80px -20px rgba(238, 106, 52, 0.25);
    color: #f6efe7;
    overflow: hidden;
    transform-origin: 50% 0;
    font-size: 13px;
  }
  .b-bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid rgba(255, 236, 220, 0.07); }
  .b-title { font-weight: 600; margin-right: 10px; }
  .b-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px; background: rgba(255, 255, 255, 0.07); font-size: 12px; }
  .b-btn.ghost { background: none; color: rgba(246, 239, 231, 0.75); }
  .b-ctl { margin-left: auto; display: flex; align-items: center; gap: 18px; color: rgba(246, 239, 231, 0.6); }
  .b-ctl i { width: 10px; height: 1.5px; background: currentColor; }
  .b-ctl i:nth-child(3) { height: 9px; width: 9px; background: none; border: 1.3px solid currentColor; border-radius: 2px; }
  .b-body { display: grid; grid-template-columns: 250px 1fr; min-height: 470px; }
  .b-side { margin: 10px; padding: 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 236, 220, 0.06); display: flex; flex-direction: column; gap: 10px; }
  .b-tabs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding: 3px; border-radius: 9px; background: rgba(0, 0, 0, 0.25); text-align: center; }
  .b-tabs span { padding: 5px; border-radius: 7px; color: rgba(246, 239, 231, 0.7); }
  .b-tabs .on { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .b-search { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 8px; background: rgba(0, 0, 0, 0.25); color: rgba(246, 239, 231, 0.45); font-size: 12px; }
  .b-label { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(246, 239, 231, 0.45); }
  .b-rows { display: grid; gap: 4px; }
  .b-rows li { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 7px; }
  .b-rows li:hover { background: rgba(255, 255, 255, 0.05); }
  .b-from { font-weight: 650; }
  .b-to { display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px; border-radius: 6px; background: rgba(255, 255, 255, 0.07); }
  .b-q { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; }
  .b-q + .b-q { margin-top: 0; }
  .b-seg { display: inline-flex; padding: 2px; border-radius: 8px; background: rgba(0, 0, 0, 0.25); }
  .b-seg span { padding: 4px 9px; border-radius: 6px; color: rgba(246, 239, 231, 0.65); }
  .b-seg .on { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .b-sel { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 7px; background: rgba(0, 0, 0, 0.25); }
  .b-done { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: rgba(246, 239, 231, 0.7); opacity: 0; transform: translateY(6px); transition: opacity 300ms, transform 500ms var(--spring-bouncy); }
  .b-done :global(svg) { color: #6fd69a; }
  .board:global(.done) .b-done { opacity: 1; transform: none; }
  .b-go {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    border-radius: 9px;
    background: linear-gradient(135deg, #f79a45, #d9482b);
    color: #1a0d07;
    font-weight: 650;
    font-size: 13px;
    transition: transform 400ms var(--spring-bouncy), filter 200ms;
  }
  .b-go:hover { filter: brightness(1.08); }
  .b-go:active { transform: scale(0.96, 0.9); }
  .b-grid { padding: 14px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-content: start; }
  .b-card {
    padding: 7px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 236, 220, 0.07);
    transition: border-color 300ms, transform 500ms var(--spring-bouncy), background 300ms;
  }
  .b-card:hover { transform: translateY(-3px); border-color: rgba(255, 236, 220, 0.16); }
  .b-card:global(.ok) { border-color: rgba(111, 214, 154, 0.28); }
  .b-thumb { position: relative; aspect-ratio: 1.55; border-radius: 8px; background: rgba(0, 0, 0, 0.3); overflow: hidden; display: grid; place-items: center; }
  .b-type { position: absolute; right: 6px; bottom: 6px; padding: 2px 6px; border-radius: 5px; background: rgba(0, 0, 0, 0.6); font: 600 10px/1.3 var(--font-mono); }
  .t-doc::before, .t-pdf::before, .t-resume::before {
    content: '';
    width: 44%;
    height: 86%;
    border-radius: 2px;
    background:
      linear-gradient(#cfd6e4, #cfd6e4) 14% 18% / 50% 5px no-repeat,
      repeating-linear-gradient(#fff 0 9px, #dfe3ea 9px 10px) 14% 40% / 72% 50% no-repeat,
      #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  .t-resume::before { background: linear-gradient(90deg, #2f3e64 0 30%, transparent 30%), repeating-linear-gradient(#fff 0 8px, #dfe3ea 8px 9px) 70% 50% / 55% 70% no-repeat, #fff; }
  .t-doc::after { content: ''; position: absolute; width: 22%; height: 18%; top: 44%; border-radius: 2px; background: linear-gradient(160deg, #6fd69a, #2f8f5b); }
  .t-sunset { background: radial-gradient(circle at 62% 35%, #fff6c8 0 12%, rgba(255, 240, 200, 0.4) 18%, transparent 30%), linear-gradient(180deg, #4f8fc0, #f0b15e 70%, #e07b39); }
  .t-photo { background: radial-gradient(circle at 30% 30%, #ffd9a8 0 10%, transparent 11%), linear-gradient(170deg, transparent 55%, #2e5d43 56%), linear-gradient(180deg, #7fb7e6, #cfe8f5 55%); }
  .t-md::before, .t-csv::before { content: ''; width: 38%; aspect-ratio: 1; border-radius: 10px; background: rgba(120, 199, 255, 0.18); }
  .t-csv::before { background: rgba(95, 208, 140, 0.18); }
  .b-ring { position: absolute; width: 34px; height: 34px; opacity: 0; transition: opacity 200ms; }
  .b-ring circle { fill: rgba(0, 0, 0, 0.55); stroke: #f7853e; stroke-width: 3; stroke-dasharray: 100; stroke-dashoffset: 100; transform: rotate(-90deg); transform-origin: 18px 18px; }
  .board:global(.running) .b-card:not(:global(.ok)) .b-ring { opacity: 1; }
  .board:global(.running) .b-card:not(:global(.ok)) .b-ring circle { animation: fill var(--dur, 1s) linear forwards; }
  @keyframes fill { to { stroke-dashoffset: 0; } }
  .b-name { margin-top: 7px; font-weight: 550; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12.5px; }
  .b-size { font-size: 11px; }
  .b-status { position: relative; height: 18px; font-size: 11.5px; overflow: hidden; }
  .b-status span { position: absolute; inset: 0; display: flex; align-items: center; gap: 4px; transition: transform 500ms var(--spring-bouncy), opacity 250ms; }
  .s-wait { color: rgba(246, 239, 231, 0.6); }
  .s-ok { color: #6fd69a; transform: translateY(100%); opacity: 0; }
  .b-card:global(.ok) .s-wait { transform: translateY(-100%); opacity: 0; }
  .b-card:global(.ok) .s-ok { transform: none; opacity: 1; }
  .b-card:global(.ok) { animation: pop 500ms var(--spring-bouncy); }
  @keyframes pop { 40% { transform: scale(1.04); } }
  .b-foot { display: flex; justify-content: space-between; padding: 8px 14px; border-top: 1px solid rgba(255, 236, 220, 0.07); font-size: 11.5px; color: rgba(246, 239, 231, 0.65); }
  .callout {
    position: absolute;
    padding: 8px 14px;
    border-radius: 12px;
    background: var(--glass-strong);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow-3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.86rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .callout b { color: var(--ember-ink); margin-right: 6px; }
  .c1 { left: 6%; bottom: -18px; }
  .c2 { right: -20px; top: 16%; }
  .c3 { right: -20px; top: 64%; }
  .board-feats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; margin-top: 72px; }
  .board-feats li { display: grid; gap: 12px; align-content: start; }
  .board-feats li > :global(svg) { width: 26px; height: 26px; color: var(--ember-hot); }
  .board-feats h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .board-feats p { font-size: 0.95rem; }
  @media (max-width: 980px) {
    .board-head { grid-template-columns: 1fr; }
    .b-body { grid-template-columns: 1fr; }
    .b-side { display: none; }
    .b-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-btn.ghost, .b-ctl { display: none; }
    .callout { display: none; }
    .board-feats { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .b-go-mobile { display: block; }
  }
  @media (max-width: 560px) {
    .board-feats { grid-template-columns: 1fr; }
  }
</style>
