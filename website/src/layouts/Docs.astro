---
// Docs: sidebar (sections), the article, and an "On this page" list that follows your
// scroll. On phones the sidebar is a drawer you can swipe closed.
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { LINKS } from '../data/site';

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, slug, headings } = Astro.props;
const SECTIONS = ['Start', 'Using Swirvo', 'Power users', 'Help'] as const;
const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const flat = SECTIONS.flatMap((s) => all.filter((d) => d.data.section === s));
const i = flat.findIndex((d) => d.id === slug);
const prev = flat[i - 1];
const next = flat[i + 1];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const current = flat[i];
---
<Base title={title} description={description} bodyClass="docs-body">
  <div class="docs wrap-wide">
    <button class="docs-menu btn btn-glass btn-sm" type="button" data-drawer-open aria-controls="docs-nav" aria-expanded="false">
      <Icon name="menu" size={16} /> {current?.data.section} · {current?.data.short ?? title}
    </button>

    <aside class="side" id="docs-nav" data-drawer aria-label="Documentation">
      <div class="side-in" data-drawer-panel>
        <div class="side-top">
          <span class="eyebrow">Docs</span>
          <button class="side-x" type="button" data-drawer-close aria-label="Close"><Icon name="x" size={18} /></button>
        </div>
        <button class="side-search" type="button" data-search-open><Icon name="search" size={16} />Search docs<kbd>Ctrl K</kbd></button>
        <nav data-side-nav>
          <span class="side-ind" aria-hidden="true"></span>
          {SECTIONS.map((s) => (
            <div class="side-sec">
              <p class="side-h">{s}</p>
              <ul role="list">
                {all.filter((d) => d.data.section === s).map((d) => (
                  <li>
                    <a href={`/docs/${d.id}`} class:list={{ on: d.id === slug }} aria-current={d.id === slug ? 'page' : undefined}>
                      {d.data.short ?? d.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
        <div class="side-foot">
          <a class="ulink" href={LINKS.issues} target="_blank" rel="noopener"><Icon name="github" size={14} /> Ask a question</a>
        </div>
      </div>
      <div class="side-scrim" data-drawer-close></div>
    </aside>

    <article class="doc">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/docs/getting-started">Docs</a><Icon name="chevronRight" size={14} /><span>{current?.data.section}</span>
      </nav>
      <h1 data-split>{title}</h1>
      <p class="lead" data-reveal style="--delay:100ms">{description}</p>
      <div class="prose doc-body" data-doc-body>
        <slot />
      </div>
      <div class="doc-foot">
        <a class="ulink faint" href={`${LINKS.editDocs}${slug}.md`} target="_blank" rel="noopener"><Icon name="feather" size={14} /> Suggest a change to this page</a>
      </div>
      <nav class="pager" aria-label="Previous and next">
        {prev ? (
          <a class="pg card" href={`/docs/${prev.id}`} data-magnetic="0.08"><span class="faint"><Icon name="chevronLeft" size={14} /> Previous</span><b>{prev.data.title}</b></a>
        ) : <span></span>}
        {next && (
          <a class="pg card next" href={`/docs/${next.id}`} data-magnetic="0.08"><span class="faint">Next <Icon name="chevronRight" size={14} /></span><b>{next.data.title}</b></a>
        )}
      </nav>
    </article>

    <aside class="toc" aria-label="On this page">
      {toc.length > 1 && (
        <div class="toc-in">
          <p class="eyebrow">On this page</p>
          <ul role="list" data-toc>
            <span class="toc-bar" aria-hidden="true"></span>
            {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
          </ul>
          <a class="toc-top ulink faint" href="#main"><Icon name="arrowRight" size={13} /> Back to top</a>
        </div>
      )}
    </aside>
  </div>
</Base>

<script>
  import { Spring, onTick, reduced, toast } from '../scripts/motion';

  /* Wide tables scroll inside their own box instead of stretching the page */
  document.querySelectorAll<HTMLTableElement>('.doc-body table').forEach((t) => {
    const w = document.createElement('div');
    w.className = 'table-wrap';
    t.replaceWith(w);
    w.append(t);
  });

  /* Copy buttons on code blocks, and anchors on headings */
  document.querySelectorAll<HTMLPreElement>('.doc-body pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'code-copy';
    b.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="3"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>Copy';
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.trim());
        b.classList.add('copied');
        toast('Copied to the clipboard');
        setTimeout(() => b.classList.remove('copied'), 1500);
      } catch {}
    });
    wrap.append(b);
  });
  document.querySelectorAll<HTMLElement>('.doc-body h2[id], .doc-body h3[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to “${h.textContent}”`);
    h.append(a);
  });

  /* Sidebar indicator: a bar that springs to the current page */
  const nav = document.querySelector<HTMLElement>('[data-side-nav]');
  const ind = nav?.querySelector<HTMLElement>('.side-ind');
  const on = nav?.querySelector<HTMLElement>('a.on');
  if (nav && ind && on) {
    const place = () => {
      ind.style.transform = `translateY(${on.offsetTop}px)`;
      ind.style.height = `${on.offsetHeight}px`;
    };
    place();
    on.scrollIntoView({ block: 'center' });
    addEventListener('resize', place);
  }

  /* Scroll spy for "On this page" */
  const tocList = document.querySelector<HTMLElement>('[data-toc]');
  if (tocList) {
    const bar = tocList.querySelector<HTMLElement>('.toc-bar')!;
    const links = [...tocList.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const heads = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
    const y = new Spring(0, 260, 26);
    const hgt = new Spring(0, 260, 26);
    let stop: (() => void) | null = null;
    let active = -1;
    const draw = () => {
      bar.style.transform = `translateY(${y.value}px)`;
      bar.style.height = `${Math.max(0, hgt.value)}px`;
    };
    const set = (i: number) => {
      if (i === active) return;
      active = i;
      links.forEach((l, k) => l.classList.toggle('on', k === i));
      const li = links[i]?.parentElement;
      if (!li) return;
      y.target = li.offsetTop;
      hgt.target = li.offsetHeight;
      if (reduced || !bar.style.height) {
        y.value = y.target;
        hgt.value = hgt.target;
        draw();
        return;
      }
      if (stop) return;
      stop = onTick((dt) => {
        y.step(dt);
        hgt.step(dt);
        draw();
        if (y.settled && hgt.settled) {
          stop = null;
          return false;
        }
      });
    };
    const spy = () => {
      let i = 0;
      for (let k = 0; k < heads.length; k++) if (heads[k].getBoundingClientRect().top < 140) i = k;
      set(i);
    };
    let q = false;
    addEventListener('scroll', () => {
      if (!q) {
        q = true;
        requestAnimationFrame(() => {
          q = false;
          spy();
        });
      }
    }, { passive: true });
    spy();
  }

  /* Drawer on phones: tap to open, tap the scrim or swipe left to close */
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('[data-drawer-panel]');
  const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  if (drawer && panel && opener) {
    const setOpen = (open: boolean) => {
      drawer.classList.toggle('open', open);
      opener.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      panel.style.transform = '';
      if (open) panel.querySelector<HTMLElement>('a.on, a')?.focus({ preventScroll: true });
    };
    opener.addEventListener('click', () => setOpen(true));
    drawer.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (e) => e.key === 'Escape' && drawer.classList.contains('open') && setOpen(false));
    let x0 = 0;
    let dx = 0;
    let drag = false;
    panel.addEventListener('pointerdown', (e) => {
      if (!drawer.classList.contains('open') || e.pointerType === 'mouse') return;
      drag = true;
      x0 = e.clientX;
      dx = 0;
      panel.style.transition = 'none';
    });
    panel.addEventListener('pointermove', (e) => {
      if (!drag) return;
      dx = Math.min(0, e.clientX - x0);
      if (dx < -6) panel.style.transform = `translateX(${dx}px)`;
    });
    const end = () => {
      if (!drag) return;
      drag = false;
      panel.style.transition = '';
      if (dx < -90) setOpen(false);
      else panel.style.transform = '';
    };
    panel.addEventListener('pointerup', end);
    panel.addEventListener('pointercancel', end);
  }
</script>

<style>
  .docs { display: grid; grid-template-columns: 250px minmax(0, 1fr) 220px; gap: 48px; padding-top: 32px; align-items: start; }
  .docs-menu { display: none; }
  .side { position: sticky; top: 84px; max-height: calc(100vh - 100px); }
  .side-in { max-height: inherit; overflow-y: auto; padding: 4px 8px 20px 0; overscroll-behavior: contain; }
  .side-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .side-x, .side-scrim { display: none; }
  .side-search { width: 100%; display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text-3); font-size: 0.88rem; margin-bottom: 18px; transition: border-color 200ms, color 200ms; }
  .side-search:hover { border-color: var(--line-3); color: var(--text-2); }
  .side-search kbd { margin-left: auto; font-size: 0.68rem; height: 1.8em; }
  [data-side-nav] { position: relative; }
  .side-ind { position: absolute; left: 0; top: 0; width: 100%; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--line); pointer-events: none; transition: transform 500ms var(--spring-snappy), height 500ms var(--spring-snappy); }
  .side-ind::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 3px; background: var(--ember); }
  .side-sec + .side-sec { margin-top: 20px; }
  .side-h { font: 500 0.72rem var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-3); margin: 0 0 6px 12px; }
  .side-sec ul { display: grid; gap: 1px; }
  .side-sec a { position: relative; display: block; padding: 7px 12px; border-radius: 10px; font-size: 0.93rem; color: var(--text-2); transition: color 200ms, transform 400ms var(--spring-bouncy); }
  .side-sec a:hover { color: var(--text); transform: translateX(3px); }
  .side-sec a.on { color: var(--text); font-weight: 600; }
  .side-foot { margin-top: 24px; padding: 12px; font-size: 0.86rem; }
  .side-foot a { display: inline-flex; align-items: center; gap: 6px; color: var(--text-2); }

  .doc { min-width: 0; padding-bottom: var(--s-9); }
  .crumbs { display: flex; align-items: center; gap: 6px; font-size: 0.86rem; color: var(--text-3); }
  .crumbs a:hover { color: var(--text); }
  .doc h1 { font-size: var(--step-5); margin: 14px 0 14px; }
  .doc .lead { margin-bottom: 36px; }
  .doc-body { max-width: 760px; }
  .doc-foot { margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 0.88rem; }
  .doc-foot a { display: inline-flex; align-items: center; gap: 6px; }
  .pager { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: 28px; max-width: 760px; }
  .pg { --bx: 0px; --by: 0px; padding: 16px 18px; display: grid; gap: 4px; transform: translate3d(var(--bx), var(--by), 0); transition: transform 500ms var(--spring-bouncy), border-color 200ms; }
  .pg:hover { border-color: var(--line-3); }
  .pg span { display: inline-flex; align-items: center; gap: 4px; font-size: 0.82rem; }
  .pg b { font-size: 1.02rem; }
  .pg.next { text-align: right; justify-items: end; }

  .toc { position: sticky; top: 100px; }
  .toc-in { display: grid; gap: 10px; }
  .toc ul { position: relative; display: grid; gap: 2px; border-left: 1px solid var(--line-2); }
  .toc-bar { position: absolute; left: -1px; top: 0; width: 2px; height: 0; background: var(--ember); border-radius: 2px; }
  .toc li a { display: block; padding: 4px 0 4px 14px; font-size: 0.85rem; color: var(--text-3); line-height: 1.4; transition: color 200ms; }
  .toc li.d3 a { padding-left: 26px; font-size: 0.82rem; }
  .toc li a:hover { color: var(--text-2); }
  .toc li a:global(.on) { color: var(--text); }
  .toc-top { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; margin-top: 8px; }
  .toc-top :global(svg) { rotate: -90deg; }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: 230px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 860px) {
    .docs { grid-template-columns: 1fr; padding-top: 16px; }
    .docs-menu { display: inline-flex; justify-self: start; position: sticky; top: 78px; z-index: 6; }
    .side { position: fixed; inset: 0; z-index: var(--z-menu); max-height: none; pointer-events: none; }
    .side.open { pointer-events: auto; }
    .side-in { position: absolute; left: 0; top: 0; bottom: 0; width: min(320px, 86vw); max-height: none; padding: 20px; background: var(--bg); border-right: 1px solid var(--line-2); box-shadow: var(--shadow-3); transform: translateX(-105%); transition: transform 560ms var(--spring-soft); z-index: 1; touch-action: pan-y; }
    .side.open .side-in { transform: none; }
    .side-scrim { display: block; position: absolute; inset: 0; background: color-mix(in oklab, var(--bg) 60%, transparent); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); opacity: 0; transition: opacity 300ms; }
    .side.open .side-scrim { opacity: 1; }
    .side-x { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; }
  }
</style>
