# Package identity for the Microsoft Store (MSIX). Read by scripts/build-msix.sh and
# scripts/build-res.sh.
#
# REPLACE these with the values Partner Center gives you after you reserve the name:
#   Partner Center > Apps and games > Swirvo > Product management > Product identity
#     Package/Identity/Name               -> IDENTITY_NAME
#     Package/Identity/Publisher          -> PUBLISHER  (starts with "CN=")
#     Package/Properties/PublisherDisplayName -> PUBLISHER_DISPLAY_NAME
#
# Until then the placeholders below build a package for local testing only
# (scripts/sign-msix.ps1 signs it with a throwaway certificate for this Publisher).
IDENTITY_NAME="SwirvoPlaceholder.Swirvo"
PUBLISHER="CN=Swirvo Test Publisher"
PUBLISHER_DISPLAY_NAME="Nabarup"
